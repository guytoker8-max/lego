{
  "expo": {
    "name": "Kitsnap",
    "slug": "kitsnap",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "kitsnap",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#FFCF3F"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Kitsnap needs your photos so it can turn one into a brick model.",
        "NSCameraUsageDescription": "Kitsnap uses the camera to photograph the thing you want built."
      }
    },
    "android": {
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE"
      ]
    },
    "plugins": [
      "expo-router"
    ],
    "extra": {
      "apiUrl": "https://bricksnap.onrender.com"
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    }
  }
}
